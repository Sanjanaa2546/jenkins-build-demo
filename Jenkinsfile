pipeline {
    agent any

    tools {
        maven 'maven3'
        jdk 'jdk17'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }
        stage('Test') {
            steps {
                bat 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('Docker Build') {
            steps {
                bat 'docker build -t jenkins-build-demo:%BUILD_NUMBER% .'
            }
        }
        stage('Run Container') {
            steps {
                bat 'docker run --rm jenkins-build-demo:%BUILD_NUMBER%'
            }
        }
    }
}